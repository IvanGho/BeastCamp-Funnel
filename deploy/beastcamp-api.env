# Variables del servicio de BeastCamp. Copiá este archivo a /etc/beastcamp/beastcamp-api.env,
# completá los valores AHÍ (no en el repo) y dejalo con permisos 600 y dueño root:
#   sudo install -d -m 755 /etc/beastcamp
#   sudo install -m 600 -o root -g root deploy/beastcamp-api.env /etc/beastcamp/beastcamp-api.env
# Sin comillas y sin espacios alrededor del «=». Una variable vacía cuenta como no configurada.
# Después de cambiar algo: sudo systemctl restart beastcamp-api

# --- Obligatorias ---

# Dirección pública del sitio, con https y sin barra final. Se usa en los links de los mails y en los eventos de Meta.
BASE_URL=

# Token del webhook de Hilvapay. Inventá uno largo (por ejemplo: openssl rand -hex 32) y cargá el MISMO en los tres
# destinos de Hilvapay. Sin esto el servicio rechaza los avisos con 503 y NO entra ninguna compra.
HILVAPAY_WEBHOOK_TOKEN=

# --- Mails de acceso (Resend). Sin RESEND_API_KEY no se manda ningún mail ---

# Clave de la API de Resend (empieza con re_). Con permiso de envío alcanza.
RESEND_API_KEY=
# Quién manda, con un dominio ya verificado en Resend. Ejemplo: BeastCamp <acceso@tudominio.com>
MAIL_DESDE=

# --- Meta (Conversions API, solo desde el servidor). Activo solo si están el píxel y el token ---

# ID numérico del píxel (Events Manager).
META_PIXEL_ID=
# Token de acceso de la API de conversiones (Events Manager > Configuración > API de conversiones).
META_CAPI_TOKEN=
# Opcional: código de «Probar eventos» (algo como TEST12345). Solo mientras probás; después, vacío.
META_TEST_EVENT_CODE=
# Opcional: versión del Graph API (por defecto v21.0). Formato vK.N, por ejemplo v22.0.
META_API_VERSION=

# --- Opcionales (ya tienen valor por defecto; descomentá solo si hace falta cambiarlas) ---

# Carpeta de datos. Por defecto la que crea systemd (StateDirectory): /var/lib/beastcamp
#DATA_DIR=
# Puerto del servicio (por defecto 3000; tiene que coincidir con proxy_pass de nginx.conf).
#PORT=
# Dirección donde escucha (por defecto 127.0.0.1; 0.0.0.0 solo dentro de un contenedor).
#HOST=

# --- Solo desarrollo ---

# 1 = en vez de mandar el mail, imprime el link en el log. NUNCA en producción: el link es el acceso del comprador.
MAIL_A_CONSOLA=
